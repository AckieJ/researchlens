# Copy into Render -> Environment. NO quotes around values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERIFY_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001      # (EMBEDDING_MODEL also accepted)
OPENALEX_API_KEY=your-openalex-key
BRIGHT_DATA_API_KEY=your-bright-data-api-key
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1      # the ZONE NAME from the Bright Data dashboard, NOT the API key
BRIGHT_DATA_SCHOLAR_ZONE=                    # leave blank to reuse the unlocker zone
RUN_INLINE=true
LLM_CONCURRENCY=4
MAX_PAPERS=15
MAX_PAIRS=40
# Only if you use a custom frontend domain:
# CORS_ORIGINS=https://your-domain.com
# Free-tier Gemini embedding quota is ~30,000 tokens/min; these keep embedding under it
MAX_CANDIDATES=60
EMBED_TOKENS_PER_MIN=22000
# Speed: parallel fetches, and reuse of earlier workspaces' embeddings/claims/verdicts (set REUSE_CACHE=false after changing models or prompts)
IO_CONCURRENCY=6
REUSE_CACHE=true

# ---- Speed / consistency (new) ----
# Same or near-identical question within CACHE_DAYS -> the finished analysis is reused instantly (tick "Re-run from scratch" to bypass).
CACHE_DAYS=30
SEMANTIC_CACHE_THRESHOLD=0.97
# Deterministic model output (temperature 0 + fixed seed). Use GEMINI_TEMPERATURE=default to leave the model's own default.
GEMINI_TEMPERATURE=0
GEMINI_SEED=7
# Set to your Gemini plan's requests-per-minute (free tier ~10) so calls are paced instead of hitting 429 and sleeping 30+ s.
# 0 = no client-side limit (use on a paid key).
GEMINI_RPM=0
# Characters of each paper the extractor reads (findings-rich passages kept first). Lower = faster.
MAX_TEXT_CHARS=40000
# Google Scholar via Bright Data: only the first N queries, in parallel with OpenAlex. Expansion via OpenAlex unless SCHOLAR_EXPAND=true.
SCHOLAR_QUERIES=2
SCHOLAR_EXPAND=false

# ---- Balance: show criticism, null results and conflicts, not only agreement (all optional) ----
CRITICAL_QUERIES=3
CRITICAL_SHARE=0.30
SCHOLAR_CRITICAL_QUERIES=1
CONTRA_PAIR_SHARE=0.50
CONTRA_MATCH_THRESHOLD=0.68
CONTRA_STRONG_MATCH=0.76
