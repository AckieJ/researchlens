# Copy into Render -> Environment. NO quotes around values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_VERIFY_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001      # (EMBEDDING_MODEL also accepted)
OPENALEX_API_KEY=your-openalex-key
BRIGHT_DATA_API_KEY=your-bright-data-api-key
BRIGHT_DATA_UNLOCKER_ZONE=web_unlocker1      # the ZONE NAME from the Bright Data dashboard, NOT the API key
BRIGHT_DATA_SCHOLAR_ZONE=                    # leave blank to reuse the unlocker zone
RUN_INLINE=true
LLM_CONCURRENCY=2
MAX_PAPERS=15
MAX_PAIRS=40
# Only if you use a custom frontend domain:
# CORS_ORIGINS=https://your-domain.com
